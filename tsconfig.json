{
  // Engine (src/ts/spim) + command line (src/ts/cli): ES modules, strict.
  // The GUI has its own config: tsconfig.app.json
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/ts/spim", "src/ts/cli"]
}
