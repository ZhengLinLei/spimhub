{
  "name": "spimhub",
  "version": "1.0.0",
  "description": "SpimHub - A MIPS Assembly IDE for Web Browsers: editor, MIPS32 assembler and simulator",
  "license": "MIT",
  "author": "ZhengLinLei <zheng9112003@icloud.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhengLinLei/spimhub-depr.git"
  },
  "bin": {
    "spimhub": "bin/spimhub.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.app.json",
    "start": "npm run build && node scripts/serve.js",
    "test": "npm run build && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.24.2",
    "sass": "^1.77.0",
    "typescript": "^5.9.3"
  },
  "main": "dist/spim.cjs"
}
